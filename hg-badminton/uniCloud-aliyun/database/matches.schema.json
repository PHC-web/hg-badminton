    "location": { "bsonType": "string" },
    "geo": { "bsonType": "object", "description": "地图选点：name/address/latitude/longitude" },
    "startDate": {},
    "endDate": {},
    "registerStart": {},
    "registerEnd": {},
    "status": { "bsonType": "string", "description": "比赛状态" },
