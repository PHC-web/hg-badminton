# 网页后台（npm run dev:h5 / build:h5）连接阿里云 uniCloud
# 复制为本文件旁的 .env.local 后填写（.env.local 已 gitignore）
# 控制台：https://unicloud.dcloud.net.cn → 服务空间列表

VITE_UNICLOUD_SPACE_NAME=hg-badminton
VITE_UNICLOUD_SPACE_ID=
VITE_UNICLOUD_CLIENT_SECRET=
# 阿里云商用版 / mp- 开头的空间用 next；公测版用 https://api.bspapp.com
VITE_UNICLOUD_ENDPOINT=https://api.next.bspapp.com

# 微信小程序代码上传（npm run release:mp-weixin）
# 密钥：mp.weixin.qq.com → 管理 → 开发管理 → 开发设置 → 小程序代码上传
# 下载的 private.<AppID>.key 放在项目根目录（*.key 已 gitignore）
WX_PRIVATE_KEY_PATH=private.wxeb6b00b05824cf81.key
# CI 机器人 1～30。第一次在公众平台把该机器人的开发版选为体验版，之后同一机器人上传会更新体验版
WX_CI_ROBOT=1
